# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Supabase -----------------------------------------------------------------
# Safe to expose: these reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never be prefixed with NEXT_PUBLIC_.
# Required for password hashes to stay unreadable by the anon role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication -----------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out. Required in production.
AUTH_SECRET=

# --- Scheduled jobs -----------------------------------------------------------
# Guards GET /api/notifications/check-kpi. Vercel Cron sends it automatically
# once the variable is set in the project settings.
CRON_SECRET=

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "KPI System <kpi@yourdomain.com>"
RESEND_FROM=

# --- Local development (optional) ---------------------------------------------
# Overrides for the local JSON store. Defaults sit in the project root.
# KPI_DATA_FILE=
# KPI_NOTIFICATIONS_FILE=
# Secondary copy of data.json, e.g. a synced drive. Unset by default.
# KPI_BACKUP_FILE=
